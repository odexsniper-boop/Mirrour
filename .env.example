# Copy to .env and fill in. .env is never served to the browser.
ALCHEMY_API_KEY=
# Optional: override the Solana RPC (takes priority over Alchemy)
# SOLANA_RPC_URL=
# Optional: start with live wallet watching off
# ODEX_LIVE_WATCH=0
# Optional: Supabase cloud backup (service role key; stays on the server)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_KEY=
# SUPABASE_TABLE=odex_kv
# Optional: let other devices on your network open the terminal (default: this computer only)
# ODEX_HOST=0.0.0.0
# --- Real trading (used only when Paper Trading is OFF) ---
# Private key of a wallet made ONLY for the bot (Phantom: Settings → Manage accounts → Show private key).
# Never put your main wallet here. This file stays on this computer.
# ODEX_TRADER_KEY=
# Optional Jupiter API key (works without one, with lower rate limits)
# JUPITER_API_KEY=
# Limits (SOL). Per-24h cap 0 = no cap.
# ODEX_REAL_MAX_SOL_PER_TRADE=0.5
# ODEX_REAL_MAX_SOL_PER_DAY=2
# ODEX_REAL_RESERVE_SOL=0.02
